{
  "xo": {
    "rules": {
      "promise/param-names": "off",
      "@typescript-eslint/ban-types": "off"
    },
    "ignores": [
      "types/"
    ],
    "prettier": true
  },
  "bugs": {
    "url": "https://github.com/alexandroit/stackline-unified/issues"
  },
  "main": "index.js",
  "name": "@stackline/unified",
  "type": "module",
  "types": "index.d.ts",
  "author": {
    "url": "https://wooorm.com",
    "name": "Titus Wormer",
    "email": "tituswormer@gmail.com"
  },
  "funding": {
    "url": "https://opencollective.com/unified",
    "type": "opencollective"
  },
  "license": "MIT",
  "scripts": {
    "test:upstream": "node --unhandled-rejections=strict --conditions development test/index.js",
    "test": "npm run test:upstream",
    "build": "node scripts/check-payload.mjs",
    "test:package": "node scripts/test-package.mjs",
    "test:types": "tsc --ignoreConfig --noEmit --module NodeNext --moduleResolution NodeNext --target ES2022 --strict test/stackline-types.mts"
  },
  "homepage": "https://github.com/alexandroit/stackline-unified#readme",
  "keywords": [
    "unified",
    "process",
    "parse",
    "transform",
    "compile",
    "stringify",
    "serialize",
    "ast",
    "cst",
    "syntax",
    "tree",
    "content",
    "rehype",
    "retext",
    "remark",
    "stackline",
    "maintenance-fork"
  ],
  "prettier": {
    "semi": false,
    "useTabs": false,
    "tabWidth": 2,
    "singleQuote": true,
    "trailingComma": "none",
    "bracketSpacing": false
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alexandroit/stackline-unified.git"
  },
  "description": "Interface for parsing, inspecting, transforming, and serializing content through syntax trees",
  "directories": {},
  "sideEffects": false,
  "contributors": [
    {
      "url": "https://wooorm.com",
      "name": "Titus Wormer",
      "email": "tituswormer@gmail.com"
    },
    {
      "name": "Junyoung Choi",
      "email": "fluke8259@gmail.com"
    },
    {
      "name": "Hernan Rajchert",
      "email": "hrajchert@gmail.com"
    },
    {
      "name": "Christian Murphy",
      "email": "christian.murphy.42@gmail.com"
    },
    {
      "name": "Vse Mozhet Byt",
      "email": "vsemozhetbyt@gmail.com"
    },
    {
      "name": "Richard Littauer",
      "email": "richard.littauer@gmail.com"
    }
  ],
  "dependencies": {
    "bail": "^2.0.0",
    "vfile": "^5.0.0",
    "extend": "^3.0.0",
    "trough": "^2.0.0",
    "is-buffer": "^2.0.0",
    "@types/unist": "^2.0.0",
    "is-plain-obj": "^4.0.0"
  },
  "remarkConfig": {
    "plugins": [
      "preset-wooorm"
    ]
  },
  "typeCoverage": {
    "detail": true,
    "strict": true,
    "atLeast": 100,
    "ignoreCatch": true
  },
  "devDependencies": {
    "tape": "5.10.2",
    "typescript": "7.0.2",
    "@types/node": "24.12.2"
  },
  "version": "1.0.0",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "index.d.ts",
    "index.js",
    "lib/index.d.ts",
    "lib/index.js",
    "license",
    "readme.md",
    "UPSTREAM.md",
    "NOTICE",
    "CHANGELOG.md"
  ],
  "overrides": {
    "tape": {
      "glob": "^13.0.6"
    }
  }
}
